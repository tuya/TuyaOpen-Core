menu "Configure System Parameters"

    config STACK_SIZE_TIMERQ
        int "STACK_SIZE_TIMERQ: Set stack size for software timer queue"
        default 4096
        range 2048 16384

    config STACK_SIZE_WORK_QUEUE
        int "STACK_SIZE_WORK_QUEUE: Set stack size for work queue"
        default 5120
        range 2048 16384

    config MAX_NODE_NUM_WORK_QUEUE
        int "MAX_NODE_NUM_WORK_QUEUE: Set maximum node count in work queue"
        default 100
        range 10 1000

    config STACK_SIZE_MSG_QUEUE
        int "STACK_SIZE_MSG_QUEUE: Set stack size for message queue"
        default 4096
        range 2048 16384

    config MAX_NODE_NUM_MSG_QUEUE
        int "MAX_NODE_NUM_MSG_QUEUE: Set maximum node count in message queue"
        default 100
        range 10 1000
endmenu
