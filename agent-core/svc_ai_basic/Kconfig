menu "AI Protocol Configuration"

    config AI_MAX_FRAGMENT_LENGTH
        int "AI_MAX_FRAGMENT_LENGTH: Maximum fragment length"
        range 1024 512000
        default 8192

    config ENABLE_AI_PROTO_DEBUG
        bool "ENABLE_AI_PROTO_DEBUG: Enable AI protocol debug"
        default n

    config AI_BIZ_TASK_DELAY
        int "AI_BIZ_TASK_DELAY: Business send task delay (ms)"
        range 1 10000
        default 10

    config AI_SESSION_MAX_NUM
        int "AI_SESSION_MAX_NUM: Maximum AI session count"
        range 1 5
        default 2

    config AI_BIZ_MAX_NUM
        int "AI_BIZ_MAX_NUM: Maximum AI business session ID count"
        range 5 10
        default 5

    config AI_MAX_ATTR_NUM
        int "AI_MAX_ATTR_NUM: Maximum AI attribute count"
        range 5 20
        default 10

    config AI_HEARTBEAT_INTERVAL
        int "AI_HEARTBEAT_INTERVAL: AI ping heartbeat interval (s)"
        default 120

    config AI_PACKET_SECURITY_LEVEL
        int "AI_PACKET_SECURITY_LEVEL: AI packet security level"
        range 2 4
        default 4

    config AI_CLIENT_STACK_SIZE
        int "AI_CLIENT_STACK_SIZE: AI client task stack size"
        range 2048 16384
        default 4096

    config AI_READ_SOCKET_BUF_SIZE
        int "AI_READ_SOCKET_BUF_SIZE: AI server read socket buffer size"
        default 0

    config AI_WRITE_SOCKET_BUF_SIZE
        int "AI_WRITE_SOCKET_BUF_SIZE: AI server write socket buffer size"
        default 8192

    config AI_SEND_PKT_TIMEOUT
        int "AI_SEND_PKT_TIMEOUT: AI send packet timeout (s)"
        range 1 10
        default 6

    config AI_VERSION
        int "AI_VERSION: AI protocol version"
        range 1 2
        default 2

    config AI_SUB_VERSION
        int "AI_SUB_VERSION: AI protocol sub-version"
        depends on AI_VERSION = 2
        range 1 2
        default 1
endmenu
