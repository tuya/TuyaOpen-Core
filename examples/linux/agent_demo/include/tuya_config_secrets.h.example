/**
 * @file tuya_config_secrets.h.example
 * @brief Credential override template (copy to tuya_config_secrets.h and fill in real values)
 *
 * This file is probed by tuya_config.h via __has_include; when present it takes
 * precedence over the defaults. Credentials can also be overridden with
 * -DTUYA_PRODUCT_ID=... or environment variables (higher priority).
 *
 * @copyright Copyright (c) 2021-2026 Tuya Inc. All Rights Reserved.
 */

#ifndef __TUYA_CONFIG_SECRETS_H__
#define __TUYA_CONFIG_SECRETS_H__

#ifdef __cplusplus
extern "C" {
#endif

/* The three #define entries are wrapped in #ifndef so that -D / environment
 * variable injection takes priority (consistent with the #ifndef chain in
 * tuya_config.h); otherwise secrets would silently override command-line
 * credentials (with redefinition warnings). */
#ifndef TUYA_PRODUCT_ID
#define TUYA_PRODUCT_ID      "alon7qgyjj8yus74"                        // AI product PID (requires the AI service enabled)
#endif
#ifndef TUYA_OPENSDK_UUID
#define TUYA_OPENSDK_UUID      "uuidxxxxxxxxxxxxxxxx"                  // Please change the correct uuid
#endif
#ifndef TUYA_OPENSDK_AUTHKEY
#define TUYA_OPENSDK_AUTHKEY   "keyxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"      // Please change the correct authkey
#endif

#ifdef __cplusplus
}
#endif

#endif /* __TUYA_CONFIG_SECRETS_H__ */
